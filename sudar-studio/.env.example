# Sudar Studio — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# Optional: port for `npm run dev` (default 3000). Or run `npm run dev:3003`.
# PORT=3003
# If you change the dev port, set NEXTAUTH_URL to the same origin (e.g. http://localhost:3003).
#
# Windows only: Next output defaults to node_modules/.cache/sudar-studio-next to avoid EPERM on .next/trace
# (Desktop / OneDrive / Defender, and sometimes locks under %TEMP%). Use npm scripts (run-next.mjs) so
# `next` resolves from node_modules. To force `.next` inside this folder instead:
# NEXT_FORCE_PROJECT_DIST=1

# ============================================
# PRISMA / POSTGRES (Studio — migrations & prisma db push)
# ============================================
# Supabase → Project Settings → Database. If `npx prisma db push` fails with P1001 (cannot reach host),
# confirm the project is not paused, your network allows outbound DB access, and URLs match the dashboard.
# Some networks block direct 5432; use the Supabase connection pooler (Transaction mode, port 6543) for
# DATABASE_URL with `?pgbouncer=true` and keep DIRECT_URL as the direct session/5432 string when Prisma asks for both.
DATABASE_URL=
DIRECT_URL=

# ============================================
# SUPABASE (Required — shared with sudar-learn)
# ============================================
# For image upload in the course editor, create a public Storage bucket named "course-media" in Supabase Dashboard.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============================================
# AUTH
# ============================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_32_char_random_string

# ============================================
# SUDAR LEARN APP (for Integrations page — ALP base URL)
# ============================================
# Optional. Used in Studio → Integrations to show the Learn app URL for ALP and embed.
# Example: https://learn.yourorg.com or http://localhost:3001
NEXT_PUBLIC_LEARN_APP_URL=http://localhost:3001
# Shown on Integrations → Connect ChatGPT (production MCP connector URL)
NEXT_PUBLIC_MCP_URL=https://mcp.thesudar.app

# ============================================
# SUDAR INTELLIGENCE SERVICE
# ============================================
SUDAR_INTELLIGENCE_URL=http://localhost:8000

# ============================================
# AI PROVIDERS (at least one required)
# ============================================

# Together AI (recommended — cost-effective, open models)
TOGETHER_API_KEY=your_together_ai_key

# OpenAI (fallback)
OPENAI_API_KEY=your_openai_key

# Anthropic (fallback)
ANTHROPIC_API_KEY=your_anthropic_key

# Optional: local OpenAI-compatible LLM (Ollama, LM Studio). See docs/ENV_REFERENCE.md — Local LLM.
# AI_CHAT_PROVIDER=custom
# AI_CHAT_BASE_URL=http://127.0.0.1:11434
# AI_CHAT_API_KEY=ollama
# AI_CHAT_DEFAULT_MODEL=gemma3:4b

# Optional: let each organisation set a private AI URL in Org settings (Studio + Learn)
# ALLOW_ORG_PRIVATE_AI_SERVER=true
# LOCAL_LLM_BEARER_TOKEN=ollama
# PRIVATE_AI_URL_HOST_ALLOWLIST=myllm.corp.example.com,.internal.example.com

# ============================================
# MEDIA SEARCH APIS (for Search image in editor)
# ============================================
# Add your own keys to .env.local; never commit real keys.

# Google Custom Search (images + web search for research-backed content generation).
# The same Custom Search Engine can be used for both image and web search.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Pexels (stock photos + stock videos for Search image / Search video)
PEXELS_API_KEY=

# Unsplash (professional photography; no video API)
UNSPLASH_ACCESS_KEY=

# Freesound (CC0 audio for Search audio in editor). Get key: https://freesound.org/apiv2/apply/
FREESOUND_API_KEY=

# Giphy (animated GIFs)
GIPHY_API_KEY=your_giphy_key

# ============================================
# VIDEO (SudarVid — Watch modality; optional for Studio TTS/video flows)
# ============================================
# SudarVid lives in /sudar_vid. Learn uses SUDARVID_URL; set here if Studio proxies to it.
SUDARVID_URL=http://localhost:8000
REMOTION_SERVER_URL=http://localhost:3040

# ============================================
# COMPLIANCE EMAIL REMINDERS (optional)
# ============================================
# Call POST /api/cron/compliance-reminders with header "Authorization: Bearer <CRON_SECRET>"
# to send at-risk/overdue reminder emails to learners. Use a cron job (e.g. daily).
# Required before cron endpoints will run; endpoints fail closed if this is missing.
# RESEND_FROM must be a verified domain in Resend (or use onboarding@resend.dev for testing).
CRON_SECRET=
RESEND_API_KEY=
RESEND_FROM=Sudar <onboarding@resend.dev>
NOTIFICATION_UNSUBSCRIBE_SECRET=

# Optional. Comma-separated public hosts that Studio may fetch for document URL ingestion.
# If unset, any public http/https host is allowed, while local/private network hosts are blocked.
DOCUMENT_URL_HOST_ALLOWLIST=

# ============================================
# RATE LIMITING (optional — defaults provided)
# ============================================
GOOGLE_SEARCH_MAX_QUERIES_PER_DAY=100
GOOGLE_SEARCH_MAX_QUERIES_PER_HOUR=30
MAX_SEARCHES_PER_VALIDATION=5

# ============================================
# LANGFUSE (optional — observability / tracing)
# ============================================
# For AI request observability. Add keys to .env.local if you use Langfuse.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=
