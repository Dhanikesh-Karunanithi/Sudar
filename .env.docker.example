# Sudar — Docker Deployment Environment Variables
# ============================================
# Copy this file to .env and fill in all values before running docker-compose
# NEVER commit .env to version control
#
# Usage:
#   cp .env.docker.example .env
#   # Edit .env with your values
#   docker-compose up -d --build

# ============================================
# PORT CONFIGURATION
# ============================================
# Host ports: exposed on the host machine (what you access in browser)
# Container ports: internal ports inside containers (usually keep default)
# Change host ports if you have conflicts.

# Studio (Admin/Creator app)
PORT_STUDIO_HOST=3000
PORT_STUDIO_CONTAINER=3000

# Learn (Learner app)
PORT_LEARN_HOST=3001
PORT_LEARN_CONTAINER=3001

# Intelligence (AI Engine)
PORT_INTEL_HOST=8000
PORT_INTEL_CONTAINER=8000

# ============================================
# SUPABASE (Required — shared by all services)
# ============================================
# Get these from Supabase Dashboard → Project Settings → API
# Make sure to create a "course-media" storage bucket for file uploads
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database URL for Prisma (use Supabase connection pooler for production)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=your_supabase_connection_pool_url

# ============================================
# AUTH (Required — shared by Studio and Learn)
# ============================================
# Generate a random 32+ character string: openssl rand -base64 32
NEXTAUTH_SECRET=generate_a_32_char_random_string

# Public URLs for authentication (update for your domain)
# For localhost deployment:
NEXTAUTH_URL_STUDIO=http://localhost:3000
NEXTAUTH_URL_LEARN=http://localhost:3001
# For production with custom domain:
# NEXTAUTH_URL_STUDIO=https://sudar.example.com/studio
# NEXTAUTH_URL_LEARN=https://sudar.example.com/learn

# ============================================
# AI PROVIDERS (at least one required)
# ============================================
# Together AI (recommended — cost-effective, open models)
TOGETHER_API_KEY=your_together_ai_key

# OpenAI (fallback)
OPENAI_API_KEY=your_openai_key

# Anthropic (fallback)
ANTHROPIC_API_KEY=your_anthropic_key

# ============================================
# CORS CONFIGURATION (Intelligence service)
# ============================================
# Comma-separated list of origins allowed to call the Intelligence API
# For Docker deployment with Nginx reverse proxy:
# CORS_ORIGINS=https://sudar.example.com
# For localhost development:
CORS_DEFAULT_ORIGINS=http://localhost:3000,http://localhost:3001
# For production, set CORS_ORIGINS (takes precedence over CORS_DEFAULT_ORIGINS):
# CORS_ORIGINS=https://studio.yourorg.com,https://learn.yourorg.com

# ============================================
# INTELLIGENCE SERVICE URL
# ============================================
# Internal Docker network URL (containers communicate via service name)
INTELLIGENCE_URL=http://intelligence:8000

# ============================================
# RELATIVE PATH DEPLOYMENT (Optional)
# ============================================
# Set these if deploying all services under the same domain with different paths
# Example: https://sudar.example.com/studio/* → Studio, https://sudar.example.com/learn/* → Learn
# NEXT_PUBLIC_BASE_PATH_STUDIO=/studio
# NEXT_PUBLIC_BASE_PATH_LEARN=/learn

# ============================================
# MEDIA SEARCH APIS (Optional — for Studio editor)
# ============================================
# Google Custom Search (images + web search)
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_ENGINE_ID=

# Pexels (stock photos + videos)
# PEXELS_API_KEY=

# Unsplash (professional photography)
# UNSPLASH_ACCESS_KEY=

# Freesound (CC0 audio)
# FREESOUND_API_KEY=

# Giphy (animated GIFs)
# GIPHY_API_KEY=

# ============================================
# VIDEO GENERATION (Optional)
# ============================================
# REMOTION_SERVER_URL=http://localhost:3040
# BYTEOS_VIDEO_SERVICE_URL=http://localhost:5001

# ============================================
# COMPLIANCE EMAIL REMINDERS (Optional)
# ============================================
# CRON_SECRET=
# RESEND_API_KEY=
# RESEND_FROM=Sudar <onboarding@resend.dev>

# ============================================
# SUDARPLAY (Optional — Game-based learning)
# ============================================
# SUDARPLAY_JWT_SECRET=your_sudarplay_jwt_secret_min_32_chars
# WA_INSTANCE_URL=https://play.sudar.app
# SUDARPLAY_MAPS_BUCKET=sudarplay-maps
# SUDARPLAY_DEFAULT_QUIZ_PASS_THRESHOLD=0.70

# ============================================
# LANGFUSE (Optional — AI observability)
# ============================================
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_HOST=

# ============================================
# RATE LIMITING (Optional — defaults provided)
# ============================================
# GOOGLE_SEARCH_MAX_QUERIES_PER_DAY=100
# GOOGLE_SEARCH_MAX_QUERIES_PER_HOUR=30
# MAX_SEARCHES_PER_VALIDATION=5
