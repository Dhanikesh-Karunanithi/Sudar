{
  "title": "Sudar ALP + Create Suite",
  "description": "Adaptive tutoring, learner memory, and AI content generation for Canvas via LTI 1.3.",
  "privacy_level": "public",
  "oidc_initiation_url": "https://learn.example.com/api/alp/lti/launch",
  "target_link_uri": "https://learn.example.com/api/alp/lti/launch",
  "public_jwk_url": "https://learn.example.com/api/alp/lti/jwks",
  "redirect_uris": ["https://learn.example.com/api/alp/lti/launch"],
  "custom_fields": {
    "sudar_user_id": "$Canvas.user.sisIntegrationId"
  },
  "placements": {
    "course_navigation": {
      "enabled": true,
      "text": "Sudar Tutor"
    },
    "link_selection": {
      "enabled": true,
      "text": "Sudar Create"
    }
  },
  "create_embed_flow": {
    "embed_token_endpoint": "POST /api/alp/create/embed-token",
    "iframe_path": "/alp/create",
    "docs": "docs/SUDAR_CREATE_API.md"
  }
}
