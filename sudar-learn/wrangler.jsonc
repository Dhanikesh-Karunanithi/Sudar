{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "sudar-learn",
  "account_id": "c832f01f11c861e2b31cd36a0db18f36",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "sudar-learn"
    }
  ],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "learn.thesudar.com",
      "custom_domain": true
    }
  ]
}
