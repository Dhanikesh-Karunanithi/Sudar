# Sudar Learn — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# ============================================
# SUPABASE (Required — SAME project as sudar-studio)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============================================
# AUTH
# ============================================
# Production (thesudar.com): https://learn.thesudar.com
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=same_secret_as_studio

# ============================================
# SUDAR INTELLIGENCE SERVICE
# ============================================
# Note: Intelligence runs on port 8000 by default.
# If running SudarVid on the same machine, change one of the ports to avoid conflicts (e.g. Intelligence on 8001).
SUDAR_INTELLIGENCE_URL=http://localhost:8001

# Same secret Intelligence uses when calling Learn internal agent-tool routes (`/api/internal/...`).
INTELLIGENCE_SERVICE_SECRET=

# ============================================
# SUDAR SIM — Roleplay voice / chat practice
# ============================================
# Server-side: room minting, session bootstrap (see docs/SUDAR_SIM_DEPLOY.md)
SUDAR_SIM_URL=http://localhost:8090
# Client WebSocket for phone tab (dev: ws://localhost:8090)
NEXT_PUBLIC_SUDAR_SIM_WS_URL=ws://localhost:8090
# Production example:
# SUDAR_SIM_URL=https://sim-voice.yourdomain.com
# NEXT_PUBLIC_SUDAR_SIM_WS_URL=wss://sim-voice.yourdomain.com

# ============================================
# SUDARVID — Video generation microservice
# ============================================
# SudarVid lives in /sudar_vid and runs with: uvicorn sudarvid.server:app --port 8000
# Requires TOGETHER_API_KEY set in sudar_vid/.env
SUDARVID_URL=http://localhost:8000
# Optional: default engine mode requested by Learn (classic|premium). Default is classic.
SUDARVID_ENGINE_MODE=classic
# Optional: when true, premium-start failures retry once with classic mode.
SUDARVID_HTTP_FALLBACK_ENABLED=false
# Optional: HMAC for HttpOnly cookie that authorizes /api/ai/generate-video/render/... inside iframes.
# If unset, SUPABASE_SERVICE_ROLE_KEY is used (server only).
# SUDARVID_RENDER_GRANT_SECRET=

# ============================================
# ALP (Adaptive Learning Layer) — external LMS event ingestion
# ============================================
# Optional. If set, POST /api/alp/events requires x-alp-api-key or Authorization: Bearer <value>
# Used by SudarMemory (Moodle/Canvas connectors) to send learning events into Sudar.
# Learn also accepts keys from Studio → Integrations (integration_api_keys table).
ALP_API_KEY=

# Required for iframe /alp/embed tokens. Use a dedicated random secret; do not reuse ALP_API_KEY.
ALP_EMBED_SIGNING_SECRET=
# Legacy alias accepted for existing deployments. Prefer ALP_EMBED_SIGNING_SECRET for new installs.
ALP_EMBED_SECRET=

# LTI 1.3 tool JWKS JSON for GET /api/alp/lti/jwks (optional; Moodle/Canvas external tool registration).
# ALP_LTI_TOOL_JWKS_JSON={"keys":[...]}

# Production: https://learn.thesudar.com
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Required for notification unsubscribe and tracking links. Use dedicated random values.
NOTIFICATION_UNSUBSCRIBE_SECRET=
NOTIFICATION_LINK_SIGNING_SECRET=

# ============================================
# AI — Embeddings / RAG (Sudar Learn)
# ============================================
# Provider: together | openai | huggingface (default: first key available)
# EMBED_PROVIDER=huggingface
# HUGGINGFACE_API_KEY=
# HF_EMBED_MODEL=BAAI/bge-m3
# HF_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RAG_RERANK_ENABLED=true
# HF_INFERENCE_BASE_URL=
# TOGETHER_API_KEY=
# OPENAI_API_KEY=
# EMBED_MODEL=

# ============================================
# AI — Chat (cloud key OR local OpenAI-compatible server)
# ============================================
# At least one of: TOGETHER_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY, OPENROUTER_API_KEY,
# or local custom (AI_CHAT_BASE_URL + AI_CHAT_API_KEY). See docs/ENV_REFERENCE.md — Local LLM.
# TOGETHER_API_KEY=
# Optional: Ollama + Gemma example
# AI_CHAT_PROVIDER=custom
# AI_CHAT_BASE_URL=http://127.0.0.1:11434
# AI_CHAT_API_KEY=ollama
# AI_CHAT_DEFAULT_MODEL=gemma3:4b
# Optional: tutor course chat — web/image resource cards (Google Custom Search, same as Studio)
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_ENGINE_ID=
# TUTOR_WEB_ENRICHMENT_ENABLED=true
# Optional org-level private AI (see docs/ENV_REFERENCE.md)
# ALLOW_ORG_PRIVATE_AI_SERVER=true
# LOCAL_LLM_BEARER_TOKEN=ollama

# ============================================
# CRON (Learn — scheduled jobs)
# ============================================
# Required for POST/GET /api/cron/* routes (fail closed if unset).
# On Cloudflare: deploy workers/sudar-cron-learn (replaces Vercel Cron).
# On Vercel: Authorization: Bearer <CRON_SECRET> when CRON_SECRET is set.
# Optional alias if you prefer a Learn-only secret name:
# LEARN_CRON_SECRET=
CRON_SECRET=

# See sudar-learn/vercel.json — nightly learner memory digest consolidation:
# GET /api/cron/consolidate-learner-memory
# Other cron routes: notification-monthly-bonus, agent-spacing-nudges, process-kb-uploads (every 10m in vercel.json).
# KB_PROCESSING_MAX_CONCURRENCY=5
