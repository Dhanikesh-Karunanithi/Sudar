# SudarSim voice service
# Defaults: SIM_DEV_MODE on when not production; set SIM_DEV_MODE=0 in prod
SIM_DEV_MODE=1
PORT=8090
SUDAR_INTELLIGENCE_URL=http://localhost:8001
INTELLIGENCE_SERVICE_SECRET=

# Learn BFF (agent transcript sync + session context)
SUDAR_LEARN_URL=http://localhost:3001
SUDAR_LEARN_INTERNAL_SECRET=dev-sim-secret-change-me

# Required in production — Learn BFF sends X-Sudar-Sim-Secret
SUDAR_SIM_SERVICE_SECRET=dev-sim-secret-change-me
# CORS allowlist (comma-separated). Never use *
SUDAR_LEARN_ORIGINS=http://localhost:3001

# Supabase (optional direct reads)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LiveKit — local dev via docker-compose.livekit.yml
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Streaming STT / TTS (required for real-time voice)
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
DEEPGRAM_MODEL=nova-2
