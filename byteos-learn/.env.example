# ByteOS Learn — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# ============================================
# SUPABASE (Required — SAME project as byteos-studio)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============================================
# AUTH
# ============================================
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=same_secret_as_studio

# ============================================
# BYTEOS INTELLIGENCE SERVICE
# ============================================
# Note: Intelligence runs on port 8000 by default.
# If running SudarVid on the same machine, change one of the ports to avoid conflicts (e.g. Intelligence on 8001).
BYTEOS_INTELLIGENCE_URL=http://localhost:8001

# ============================================
# SUDARVID — Video generation microservice
# ============================================
# SudarVid lives in /sudar_vid and runs with: uvicorn sudarvid.server:app --port 8000
# Requires TOGETHER_API_KEY set in sudar_vid/.env
SUDARVID_URL=http://localhost:8000

# ============================================
# ALP (Adaptive Learning Layer) — external LMS event ingestion
# ============================================
# Optional. If set, POST /api/alp/events requires x-alp-api-key or Authorization: Bearer <value>
# Used by SudarMemory (Moodle/Canvas connectors) to send learning events into Sudar.
# Learn also accepts keys from Studio → Integrations (integration_api_keys table).
ALP_API_KEY=

# Optional. Signing secret for embed tokens (iframe /alp/embed). Defaults to ALP_API_KEY if not set.
ALP_EMBED_SECRET=

# Optional. Used to build embed URLs (e.g. https://learn.yourorg.com). Fallback: request origin.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ============================================
# AI — Chat (cloud key OR local OpenAI-compatible server)
# ============================================
# At least one of: TOGETHER_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY, OPENROUTER_API_KEY,
# or local custom (AI_CHAT_BASE_URL + AI_CHAT_API_KEY). See docs/ENV_REFERENCE.md — Local LLM.
# TOGETHER_API_KEY=
# Optional: Ollama + Gemma example
# AI_CHAT_PROVIDER=custom
# AI_CHAT_BASE_URL=http://127.0.0.1:11434
# AI_CHAT_API_KEY=ollama
# AI_CHAT_DEFAULT_MODEL=gemma3:4b
# Optional org-level private AI (see docs/ENV_REFERENCE.md)
# ALLOW_ORG_PRIVATE_AI_SERVER=true
# LOCAL_LLM_BEARER_TOKEN=ollama
