{
  "name": "sudar-monorepo",
  "private": true,
  "description": "Helper scripts for the Sudar repo (no install required for supabase — uses npx).",
  "scripts": {
    "help-center:sync-ai": "node scripts/sync-help-center-ai.mjs",
    "supabase": "npx --yes supabase@latest",
    "security:audit": "node scripts/security-audit.mjs",
    "benchmark:sudar": "node scripts/benchmark-sudar.mjs",
    "db:apply:agent-runs": "node scripts/apply-agent-runs-sql.cjs",
    "mcp:build": "npm run build --prefix packages/sudar-mcp",
    "mcp:remote:build": "npm run build --prefix workers/sudar-mcp-remote",
    "mcp:cloudflare:dev": "npm run dev --prefix workers/sudar-mcp-cloudflare",
    "mcp:cloudflare:deploy": "npm run deploy --prefix workers/sudar-mcp-cloudflare",
    "demo:ecosystem": "npm run dev --prefix sudar-ecosystem-demo"
  }
}
