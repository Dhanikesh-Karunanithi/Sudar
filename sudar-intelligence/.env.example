# Sudar Intelligence — Environment Variables
#
# Local dev: copy to .env.local in this folder (sudar-intelligence/). Vars are loaded from
# .env.local and .env automatically on startup — no manual export needed for uvicorn.

# AI Providers
TOGETHER_API_KEY=your_together_ai_key
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key
# Optional: local OpenAI-compatible server (Ollama, LM Studio, vLLM)
# AI_CHAT_PROVIDER=custom
# AI_CHAT_BASE_URL=http://127.0.0.1:11434
# AI_CHAT_API_KEY=ollama
# AI_CHAT_DEFAULT_MODEL=gemma3:4b

# Supabase (same project as Studio + Learn)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Required for Authorization: Bearer <supabase JWT> from Studio/Learn — same string as Supabase JWT Secret
# (Dashboard → Project Settings → API, under JWT Settings).
SUPABASE_JWT_SECRET=

# Agents bridge (NB parity + orchestration tools hitting Learn internals)
INTELLIGENCE_SERVICE_SECRET=
# Sudar Learn base URL as seen from Intelligence (e.g. http://localhost:3001 when Learn is local)
LEARN_INTERNAL_URL=http://localhost:3001

# SudarVid (Watch modality — same service Learn uses; optional for Intelligence)
SUDARVID_URL=http://localhost:8000
REMOTION_SERVER_URL=http://localhost:3040

# Server
PORT=8000
ENVIRONMENT=development
# Recognized interchangeably at startup as production when set to prod/production
ENV=development
# CORS (production only): comma-separated origins so Studio/Learn can call this API
# CORS_ORIGINS=https://sudar-studio.vercel.app,https://sudar-learn.vercel.app
# Narrow override for Allow-Headers (comma-separated); use "*" for permissive debugging only.
# CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Intelligence-Service-Secret
#
# JWT: require audience verification (recommended in production — match your Supabase JWT "aud").
# SUPABASE_JWT_AUD=authenticated
#
# Distributed rate limiting: TCP Redis URI for slowapi (omit for in-memory per process).
# RATE_LIMIT_STORAGE_URI=redis://default:PASSWORD@HOST:6379

# ============================================
# SUDARPLAY (Modality 7 — game-based learning)
# ============================================
# JWT secret for signing launch tokens (WA → Sudar API auth). Use a long random string.
SUDARPLAY_JWT_SECRET=your_sudarplay_jwt_secret_min_32_chars
# Self-hosted WorkAdventure base URL (e.g. https://play.sudar.app)
WA_INSTANCE_URL=https://play.sudar.app
# Supabase Storage bucket name for generated maps (create bucket: sudarplay-maps, public read)
SUDARPLAY_MAPS_BUCKET=sudarplay-maps
# Default quiz gate pass threshold (0.0–1.0)
SUDARPLAY_DEFAULT_QUIZ_PASS_THRESHOLD=0.70
# Optional: WorkAdventure admin API key (if using WA admin API)
# WA_ADMIN_API_KEY=
# Optional: Piston API for code lab execution (default: https://emkc.org/api/v2/piston)
# PISTON_API_URL=https://emkc.org/api/v2/piston
